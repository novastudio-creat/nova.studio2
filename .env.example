# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SITE_URL=https://YOUR-SITE.netlify.app

# PayPal (use sandbox first)
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# Optional: comma-separated currencies accepted by Stripe in your account
STRIPE_CURRENCIES=eur,usd

# Admin authentication (set these in Netlify; do not put them in frontend code)
ADMIN_EMAIL=admin@novastudio.com
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_GOING_LIVE
ADMIN_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
